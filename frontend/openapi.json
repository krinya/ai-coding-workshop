  "components": {
    "schemas": {
      "AdminSignIn": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 200,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "password"
        ],
        "title": "AdminSignIn"
      },
      "FeedbackIn": {
        "properties": {
          "rating": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Rating"
          },
          "comment": {
            "type": "string",
            "maxLength": 500,
            "title": "Comment",
            "default": ""
          },
          "photo": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 3000000
              },
              {
                "type": "null"
              }
            ],
            "title": "Photo"
          },
          "photo_consent": {
            "type": "boolean",
            "title": "Photo Consent",
            "default": false
          },
          "remove_photo": {
            "type": "boolean",
            "title": "Remove Photo",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "rating"
        ],
        "title": "FeedbackIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "database": {
            "type": "boolean",
            "title": "Database"
          },
          "llm_configured": {
            "type": "boolean",
            "title": "Llm Configured"
          }
        },
        "type": "object",
        "required": [
          "status",
          "environment",
          "database",
          "llm_configured"
        ],
        "title": "Health"
      },
      "JoinLinkStatus": {
        "properties": {
          "join_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Join Url"
          },
          "joined": {
            "type": "integer",
            "title": "Joined"
          }
        },
        "type": "object",
        "required": [
          "join_url",
          "joined"
        ],
        "title": "JoinLinkStatus"
      },
      "JoinRequest": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 64,
            "title": "Token"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": [
          "token"
        ],
        "title": "JoinRequest"
      },
      "Me": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "is_admin": {
            "type": "boolean",
            "title": "Is Admin"
          }
        },
        "type": "object",
        "required": [
          "id",
          "display_name",
          "is_admin"
        ],
        "title": "Me"
      },
      "Message": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Message"
      },
      "MyFeedback": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "rating": {
            "type": "integer",
            "title": "Rating"
          },
          "comment": {
            "type": "string",
            "title": "Comment"
          },
          "photo_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Photo Url"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "rating",
          "comment",
          "photo_url",
          "created_at",
          "updated_at"
        ],
        "title": "MyFeedback"
      },
      "PublicFeedback": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "rating": {
            "type": "integer",
            "title": "Rating"
          },
          "comment": {
            "type": "string",
            "title": "Comment"
          },
          "photo_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Photo Url"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "display_name",
          "rating",
          "comment",
          "photo_url",
          "created_at"
        ],
        "title": "PublicFeedback",
        "description": "What everyone may see. Never add the email here."
      },
      "ReactionCounts": {
        "properties": {
          "clap": {
            "type": "integer",
            "title": "Clap",
            "default": 0
          },
          "laugh": {
            "type": "integer",
            "title": "Laugh",
            "default": 0
          },
          "heart": {
            "type": "integer",
            "title": "Heart",
            "default": 0
          }
        },
        "type": "object",
        "title": "ReactionCounts"
      },
      "ReactionIn": {
        "properties": {
          "emoji": {
            "type": "string",
            "enum": [
              "clap",
              "laugh",
              "heart"
            ],
            "title": "Emoji"
