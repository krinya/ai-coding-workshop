  "components": {
    "schemas": {
      "CodeRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "CodeRequest"
      },
      "CodeVerification": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "title": "Code"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": [
          "email",
          "code"
        ],
        "title": "CodeVerification"
      },
      "FeedbackIn": {
        "properties": {
          "rating": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Rating"
          },
          "comment": {
            "type": "string",
            "maxLength": 500,
            "title": "Comment",
            "default": ""
          },
          "photo": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 3000000
              },
              {
                "type": "null"
              }
            ],
            "title": "Photo"
          },
          "photo_consent": {
            "type": "boolean",
            "title": "Photo Consent",
            "default": false
          },
          "remove_photo": {
            "type": "boolean",
            "title": "Remove Photo",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "rating"
        ],
        "title": "FeedbackIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "database": {
            "type": "boolean",
            "title": "Database"
          },
          "llm_configured": {
            "type": "boolean",
            "title": "Llm Configured"
          },
          "email_configured": {
            "type": "boolean",
            "title": "Email Configured"
          }
        },
        "type": "object",
        "required": [
          "status",
          "environment",
          "database",
          "llm_configured",
          "email_configured"
        ],
        "title": "Health"
      },
      "Me": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "display_name"
        ],
        "title": "Me"
      },
      "Message": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Message"
      },
      "MyFeedback": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "rating": {
            "type": "integer",
            "title": "Rating"
          },
          "comment": {
            "type": "string",
            "title": "Comment"
          },
          "photo_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Photo Url"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "rating",
          "comment",
          "photo_url",
          "created_at",
          "updated_at"
        ],
        "title": "MyFeedback"
      },
      "PublicFeedback": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "rating": {
            "type": "integer",
            "title": "Rating"
          },
          "comment": {
            "type": "string",
            "title": "Comment"
          },
          "photo_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Photo Url"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "display_name",
          "rating",
          "comment",
          "photo_url",
          "created_at"
        ],
        "title": "PublicFeedback",
        "description": "What everyone may see. Never add the email here."
      },
      "ReactionCounts": {
        "properties": {
          "clap": {
            "type": "integer",
            "title": "Clap",
            "default": 0
          },
          "laugh": {
            "type": "integer",
            "title": "Laugh",
            "default": 0
          },
          "heart": {
            "type": "integer",
            "title": "Heart",
            "default": 0
          }
        },
        "type": "object",
        "title": "ReactionCounts"
      },
      "ReactionIn": {
        "properties": {
          "emoji": {
            "type": "string",
            "enum": [
              "clap",
              "laugh",
              "heart"
            ],
            "title": "Emoji"
          }
        },
        "type": "object",
        "required": [
          "emoji"
        ],
        "title": "ReactionIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Wall": {
        "properties": {
          "average": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Average"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "histogram": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Histogram"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/WallEntry"
            },
            "type": "array",
            "title": "Entries"
          },
          "words": {
            "items": {
              "$ref": "#/components/schemas/WordCount"
            },
            "type": "array",
            "title": "Words"
          },
          "join_url": {
            "type": "string",
            "title": "Join Url"
          }
        },
        "type": "object",
        "required": [
          "average",
          "count",
          "histogram",
          "entries",
          "words",
          "join_url"
        ],
        "title": "Wall"
      },
      "WallEntry": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "rating": {
            "type": "integer",
            "title": "Rating"
          },
          "comment": {
            "type": "string",
            "title": "Comment"
          },
          "photo_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Photo Url"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "reactions": {
            "$ref": "#/components/schemas/ReactionCounts"
          },
          "my_reactions": {
            "items": {
              "type": "string",
              "enum": [
                "clap",
                "laugh",
                "heart"
              ]
            },
            "type": "array",
            "title": "My Reactions"
          }
        },
        "type": "object",
        "required": [
          "id",
          "display_name",
          "rating",
          "comment",
          "photo_url",
          "created_at",
          "reactions",
          "my_reactions"
        ],
        "title": "WallEntry"
      },
      "WordCount": {
        "properties": {
          "word": {
            "type": "string",
            "title": "Word"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "word",
          "count"
        ],
        "title": "WordCount"
      }
    }
  }
}
