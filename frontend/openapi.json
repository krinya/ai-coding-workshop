    "/api/feedback/{feedback_id}/reactions": {
      "post": {
        "tags": [
          "wall"
        ],
        "summary": "Toggle Reaction",
        "description": "Press once to react, press again to take it back.",
        "operationId": "toggle_reaction",
        "parameters": [
          {
            "name": "feedback_id",
