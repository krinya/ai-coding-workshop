# Copy to .env (`make setup` does it) and fill in. .env is git-ignored — never commit it.
# Empty values count as "not set". The backend reads these in backend/app/config.py.

ENVIRONMENT=development

# Host ports (change only if 5173 / 8000 are taken on your machine)
FRONTEND_PORT=5173
BACKEND_PORT=8000

# ── LLM ──────────────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Default: the HR DataLab gateway (ask the host for a key).
LLM_BASE_URL=https://llm.twinhub.nl/v1
LLM_API_KEY=
LLM_CHAT_MODEL=qwen3.8-nothink
LLM_TIMEOUT_SECONDS=120

# Optional hosted providers, if you bring your own key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Email (Resend, https://resend.com — free tier) ──────────────────────────
# Without your own verified domain, Resend only delivers from onboarding@resend.dev
# to the address you signed up with.
RESEND_API_KEY=
EMAIL_FROM=Workshop <onboarding@resend.dev>
