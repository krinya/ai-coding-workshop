# Copy to .env (`make setup` does it) and fill in. .env is git-ignored — never commit it.
# Empty values count as "not set". The backend reads these in backend/app/config.py.

ENVIRONMENT=development

# Host ports (change only if one is taken on your machine)
FRONTEND_PORT=5173
BACKEND_PORT=8000
DB_PORT=5433

# PostgreSQL (from docker compose). Seen from your machine, so the port matches DB_PORT;
# the backend container gets its own in-network address from docker-compose.yml.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/app

# ── LLM ──────────────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Default: the HR DataLab gateway (ask the host for a key).
LLM_BASE_URL=https://llm.twinhub.nl/v1
LLM_API_KEY=
LLM_CHAT_MODEL=qwen3.8-nothink
LLM_TIMEOUT_SECONDS=120

# Optional hosted providers, if you bring your own key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Email (Resend, https://resend.com — free tier) ──────────────────────────
# Without your own verified domain, Resend only delivers from onboarding@resend.dev
# to the address you signed up with.
# Leave RESEND_API_KEY empty to send every email to Mailpit instead (http://localhost:8025).
RESEND_API_KEY=
EMAIL_FROM=Workshop <onboarding@resend.dev>
# Mailpit's SMTP server, seen from your machine (docker compose sets it for the backend container)
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Any long random string, e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`
SECRET_KEY=
# true when the site is served over HTTPS
COOKIE_SECURE=false
